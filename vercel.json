{
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/:slug(isaias|isaiiaas|mother-tree|mothertree|ripple|ripple-effect|sky|circus|thirrrst|thirst|spin|kink)",
      "destination": "/index.html"
    },
    {
      "source": "/:slug(music|activities)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/events.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/map-data.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/map.webp",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
